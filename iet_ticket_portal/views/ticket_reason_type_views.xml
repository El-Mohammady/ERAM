<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="ticket_reason_type_view_form" model="ir.ui.view">
            <field name="name">ticket_reason_type_view_form</field>
            <field name="model">ticket.reason.type</field>
            <field name="arch" type="xml">
                <form string="ticket_reason_type_form">
                    <sheet>
                        <group>
                            <field name="name"/>

                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="ticket_reason_type_view_list" model="ir.ui.view">
            <field name="name">ticket_reason_type_view_list</field>
            <field name="model">ticket.reason.type</field>
            <field name="arch" type="xml">
                <list string="ticket_reason_type_list">
                    <field name="name"/>
                </list>
            </field>
        </record>
        <record id="ticket_reason_type_action" model="ir.actions.act_window">
            <field name="name">Ticket Reasons</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">ticket.reason.type</field>
            <field name="view_mode">list,form</field>
        </record>

        <!-- This Menu Item must have a parent and an action -->
        <menuitem id="ticket_reason_type_action_menu" name="Ticket Reasons" parent="helpdesk.helpdesk_menu_config"
                  action="ticket_reason_type_action"/>
    </data>

</odoo>