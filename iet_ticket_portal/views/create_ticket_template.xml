<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="helpdesk.portal_helpdesk_ticket" name="My Tickets">
            <t t-call="portal.portal_layout">
                <t t-set="breadcrumbs_searchbar" t-value="True"/>

                <t t-call="portal.portal_searchbar">
                    <t t-set="title">Tickets</t>
                </t>
                <div class="oe_structure">
                    <section class="o_job_bottom_bar mt32 mb32">
                        <div class="text-left">
                            <a role="button" t-attf-href="/ticket/new/data" class="btn btn-primary ">Create Ticket</a>
                        </div>
                    </section>
                </div>

                <div t-if="not grouped_tickets" class="alert alert-info">
                    There are currently no Ticket for your account.
                </div>
                <t t-else="">
                    <t t-call="portal.portal_table">
                        <thead>
                            <tr>
                                <th>Ticket</th>
                                <th class="text-end" t-if="groupby != 'create_date'">Reported on</th>
                                <th id="ticket_user_header" t-if="groupby != 'user_id'" class="ps-5">Assigned to</th>
                                <th t-if="groupby != 'stage_id'" colspan="5" class="text-end">Stage</th>
                            </tr>
                        </thead>
                        <t t-foreach="grouped_tickets" t-as="tickets">
                            <tbody>
                                <tr t-if="not groupby =='none'" class="table-light">
                                    <th t-if="groupby == 'stage_id'" colspan="5">
                                        <span t-field="tickets[0].stage_id.name"/>
                                    </th>
                                    <th t-if="groupby == 'user_id'" colspan="5">
                                        <span t-if="tickets[0].user_id" t-out="tickets[0].user_id.name"/>
                                        <span t-else="">Unassigned</span>
                                    </th>
                                    <th t-if="groupby == 'team_id'" colspan="6">
                                        <span t-field="tickets[0].team_id.name"/>
                                    </th>
                                    <th t-if="groupby == 'create_date'" colspan="5">
                                        <span t-field="tickets[0].create_date"/>
                                    </th>
                                    <th t-if="groupby == 'kanban_state'" colspan="6">
                                        <span t-if="tickets[0].kanban_state == 'normal'">In Progress</span>
                                        <span t-elif="tickets[0].kanban_state == 'blocked'">Blocked</span>
                                        <span t-else="tickets[0].kanban_state">Ready</span>
                                    </th>
                                    <th t-if="groupby == 'partner_id'" colspan="6">
                                        <span t-if="tickets[0].partner_id" t-field="tickets[0].partner_id.name"/>
                                        <span t-else="">No Customer</span>
                                    </th>
                                </tr>
                            </tbody>
                            <t t-foreach="tickets" t-as="ticket">
                                <tr>
                                    <td class="text-start">
                                        <a t-attf-href="/helpdesk/ticket/#{ticket.id}">
                                            <small>#</small>
                                            <t t-out="ticket.ticket_ref"/>
                                            <span class="ms-2" t-att-title="ticket.name" t-field="ticket.name"/>
                                        </a>
                                    </td>
                                    <td class="text-end" t-if="groupby != 'create_date'">
                                        <span t-field="ticket.create_date"
                                              t-options='{"widget": "datetime", "hide_seconds": True}'/>
                                    </td>
                                    <td id="ticket_user_body" t-if="groupby != 'user_id'" class="ps-5 lh-1">
                                        <img t-if="ticket.user_id" class="o_avatar o_portal_contact_img rounded"
                                             t-attf-src="#{image_data_uri(ticket.user_id.sudo().avatar_128)}"
                                             alt="Contact"/>
                                        <span t-field="ticket.user_id"/>
                                    </td>
                                    <td t-if="groupby != 'stage_id'" class="text-end">
                                        <span t-attf-class="badge rounded-pill fw-normal #{'text-bg-success' if ticket.stage_id.fold else 'text-bg-primary'}"
                                              t-esc="ticket.stage_id.name"/>
                                    </td>
                                </tr>
                            </t>
                        </t>
                    </t>
                </t>
            </t>
        </template>

        <template id="ticket_apply">
            <t t-call="website.layout">
                <div id="wrap ticket_section" class="oe_structure  oe_empty">
                    <section class="s_website_form ticket_section pt16 pb16 o_colored_level" data-vcss="001"
                             data-name="Form" style="background-image: none;">
                        <div class="container" bis_skin_checked="1">
                            <form action="/ticket/new/data/" method="post" enctype="multipart/form-data"
                                  class="o_mark_required" data-success-page="/your-ticket-has-been-submitted"
                                  data-mark="*" data-pre-fill="true" data-model_name="helpdesk.ticket"
                                  data-success-mode="redirect">
                                <div class="s_website_form_rows row s_col_no_bgcolor row gutters-20"
                                     bis_skin_checked="1">
                                    <input type="hidden" class="user_hidden" name="user"/>
                                    <div class="form-group row form-field o_website_form_required_custom"
                                         style="padding:10px">
                                        <label class="col-lg-1 col-md-4 col-form-label" for="name">Name
                                        </label>
                                        <div class="col-lg-7 col-md-8">
                                            <input class="form-control s_website_form_input" type="text"
                                                   name="name" placeholder="Ref..." required="" id="name"/>

                                        </div>
                                    </div>

                                    <div class="form-group row form-field o_website_form_required_custom d-none"
                                         style="padding:10px">
                                        <label class="col-lg-1 col-md-4 col-form-label" for="partner_id">Customer:
                                        </label>
                                        <div class="col-lg-7 col-md-8">
                                            <select class="form-control o_website_form_input" name="partner_id"
                                                    id="partner_id" >
                                                <option value="">Select Customer...</option>

                                                <t t-foreach="partners or []" t-as="partner">
                                                    <option t-att-value="partner.id"
                                                            t-att-id="'partner_' + str(partner.id)">
                                                        <t t-esc="partner.name"/>
                                                    </option>
                                                </t>
                                            </select>
                                        </div>
                                    </div>
                                    <br/>
                                    <div class="form-group row form-field o_website_form_required_custom"
                                         style="padding:10px">
                                        <label class="col-lg-1 col-md-4 col-form-label" for="partner_phone">Phone:
                                        </label>
                                        <div class="col-lg-7 col-md-8">
                                            <input class="form-control s_website_form_input" type="text"
                                                   name="phone" placeholder="Phone..." required="" id="phone"/>

                                        </div>
                                    </div>
                                    <br/>
                                    <div class="form-group row form-field o_website_form_required_custom"
                                         style="padding:10px">
                                        <label class="col-lg-1 col-md-4 col-form-label" for="reason_id">Reason:
                                        </label>
                                        <div class="col-lg-7 col-md-8">
                                            <select class="form-control o_website_form_input" name="reason_id"
                                                    id="reason_id" required="true">
                                                <option value="">Select Reason...</option>

                                                <t t-foreach="reasons or []" t-as="reason">
                                                    <option t-att-value="reason.id"
                                                            t-att-id="'reason_' + str(reason.id)">
                                                        <t t-esc="reason.name"/>
                                                    </option>
                                                </t>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="form-group row form-field o_website_form_required_custom"
                                         style="padding:10px">
                                        <label class="col-lg-1 col-md-4 col-form-label" for="team_id">Team:
                                        </label>
                                        <div class="col-lg-7 col-md-8">
                                            <select class="form-control o_website_form_input" name="team_id"
                                                    id="team_id" required="true">
                                                <!--                                                <option value="">Select Team...</option>-->

                                                <t t-foreach="teams or []" t-as="team">
                                                    <option t-att-value="team.id"
                                                            t-att-id="'team_' + str(team.id)">
                                                        <t t-esc="team.name"/>
                                                    </option>
                                                </t>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="form-group row s_website_form_field mb-3 col-12 s_website_form_custom o_website_form_required_custom"
                                         style="padding:10px" data-type="binary" data-name="Field">
                                        <label class="col-lg-1 col-md-4 col-form-label" for="attachment">Attachment
                                        </label>
                                        <div class="col-lg-7">
                                            <input class="form-control s_website_form_input"
                                                   type="file"
                                                   name="attachment"
                                                   id="attachment"/>

                                        </div>
                                    </div>


                                    <div style="padding:10px"
                                         class=" s_website_form_field mb-3 col-12 s_website_form_model_required"
                                         bis_skin_checked="1">
                                        <div class="row s_col_no_resize s_col_no_bgcolor" bis_skin_checked="1">
                                            <div class="opp_form col-sm" bis_skin_checked="1">
                                                <textarea class="form-control s_website_form_input"
                                                          placeholder="Notes" name="description"
                                                          id="description"/>
                                            </div>
                                        </div>
                                    </div>


                                    <div class="mb-0 py-2 col-12" data-name="Submit Button" bis_skin_checked="1">
                                        <div style="width: 200px;" class="s_website_form_label" bis_skin_checked="1"/>
                                        <a href="#" role="button"
                                           class="btn btn-primary s_website_form_send o_default_snippet_text">Create
                                            Ticket
                                        </a>
                                        <span id="s_website_form_result"/>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </section>
                </div>
            </t>
        </template>

    </data>
</odoo>