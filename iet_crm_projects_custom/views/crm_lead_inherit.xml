<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Form View to Modify it -->
    <record id="crm_lead_view_form_inherit_a" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='lead']//group//group//field[@name='function']" position="replace"/>
            <xpath expr="//page[@name='lead']//group//group//label[@for='mobile_page_lead']" position="replace"/>
            <xpath expr="//page[@name='lead']//group//group//div[hasclass('o_row','o_row_readonly')]" position="replace"/>
            <xpath expr="//field[@name='lost_reason_id']" position="before">
                <label for="mobile_page_lead" class="oe_inline"/>
                <div class="o_row o_row_readonly">
                    <button name="phone_action_blacklist_remove" class="fa fa-ban text-danger"
                            title="This phone number is blacklisted for SMS Marketing. Click to unblacklist."
                            type="object" context="{'default_phone': mobile}" groups="base.group_user"
                            invisible="not mobile_blacklisted"/>
                    <field name="mobile" id="mobile_page_lead" widget="phone"/>
                </div>
                <field name="function"/>
                <field name="property_number_id"/>
                <field name="project_id"/>
                <field name="number_of_rooms"/>
                <field name="area"/>
                <field name="private_space"/>
                <field name="total_area"/>
                <field name="bathroom"/>
                <field name="maid_room"/>
                <field name="maid_bathroom"/>
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="client_interests_ids" widget="many2many_tags" options="{'no_create_edit': True}"/>
                <field name="special_interests_ids" widget="many2many_tags" options="{'no_create_edit': True}"/>
                <field name="real_state_interests_ids" widget="many2many_tags" options="{'no_create_edit': True}"/>
                <field name="preferred_means_communication_ids" widget="many2many_tags" options="{'no_create_edit': True}"/>
                <field name="preferred_times_communication"/>
                <field name="purpose_purchase_ids" widget="many2many_tags" options="{'no_create_edit': True}"/>
                <field name="unit_description"/>
                <field name="driver_room"/>
                <field name="driver_bathroom"/>
                <field name="nanny"/>
            </xpath>
            <xpath expr="//group[@name='lead_priority']//field[@name='tag_ids']" position="after">
                <field name="client_interests_ids" widget="many2many_tags" options="{'no_create_edit': True}"/>
                <field name="special_interests_ids" widget="many2many_tags" options="{'no_create_edit': True}"/>
                <field name="real_state_interests_ids" widget="many2many_tags" options="{'no_create_edit': True}"/>
                <field name="preferred_means_communication_ids" widget="many2many_tags"
                       options="{'no_create_edit': True}"/>
                <field name="preferred_times_communication"/>
                <field name="purpose_purchase_ids" widget="many2many_tags" options="{'no_create_edit': True}"/>
                <field name="unit_description"/>
                <field name="driver_room"/>
                <field name="driver_bathroom"/>
            </xpath>
            <xpath expr="//field[@name='team_id']" position="after">
                <field name="property_number_id"/>
                <field name="project_id"/>
                <field name="number_of_rooms"/>
                <field name="area"/>
                <field name="private_space"/>
                <field name="total_area"/>
                <field name="bathroom"/>
                <field name="maid_room"/>
                <field name="maid_bathroom"/>
                <field name="nanny"/>
            </xpath>
            <xpath expr="//page[@name='lead']" position="after">
                <page string="Log File">
                    <field name="log_file_ids">
                        <list editable="bottom">
                            <field name="date"/>
                            <field name="name"/>
                        </list>
                    </field>
                </page>
                <page string="Similar properties">
                    <field name="similar_project_ids">
                        <list>
                            <field name="project_id"/>
                            <field name="name"/>
                            <field name="number_of_rooms"/>
                            <field name="area"/>
                            <field name="reserved_to_id"/>
                            <field name="sold_to_id"/>
                            <field name="product_template_id"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>