<odoo>

    <!-- Inherit Form View to Modify it -->
    <record id="product_template_form_view_view_inherit" model="ir.ui.view">
        <field name="name">product.template.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_tooltip']" position="after">
                <field name="property_number_id"/>
                <field name="project_name_id"/>
                <field name="number_of_rooms"/>
                <field name="total_area"/>
                <field name="unit_description"/>
            </xpath>
        </field>
    </record>

</odoo>