        </field>
    </record>

    <menuitem id="interests_root_menu" name="Interests" parent="crm.crm_menu_config">
        <menuitem
            id="client_interests_menu"
            name="Client Interests"
            action="client_interests_action"/>
        <menuitem
            id="special_interests_menu"
            name="Special Interests"
            action="special_interests_action"/>
        <menuitem
            id="real_state_interests_menu"
            name="Real State Interests"
            action="real_state_interests_action"/>
    </menuitem>


