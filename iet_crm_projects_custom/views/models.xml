<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="client_interests_form" model="ir.ui.view">
        <field name="name">Client Interests view form</field>
        <field name="model">client.interests</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="client_interests_action" model="ir.actions.act_window">
        <field name="name">Client Interests</field>
        <field name="res_model">client.interests</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create Client Interests
            </p>
        </field>
    </record>


    <record id="special_interests_form" model="ir.ui.view">
        <field name="name">Special Interests view form</field>
