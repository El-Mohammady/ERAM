<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="crm_projects_list" model="ir.ui.view">
        <field name="name">Crm Projects list</field>
        <field name="model">crm.projects</field>
        <field name="arch" type="xml">
            <list>
                <field name="project_id"/>
                <field name="name"/>
                <field name="number_of_rooms"/>
                <field name="area"/>
                <field name="reserved_to_id"/>
                <field name="sold_to_id"/>
                <field name="sale_order_id"/>
                <field name="product_template_id"/>
                <field name="state" widget="badge"
                        decoration-muted="state == 'ready'"
                        decoration-info="state == 'reserved'"
                        decoration-danger="state  == 'cancel'"
                        decoration-success="state  == 'sold'"/>
            </list>
        </field>
    </record>


    <record id="crm_projects_form" model="ir.ui.view">
        <field name="name">Crm Projects view form</field>
        <field name="model">crm.projects</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger" invisible="state != 'cancel'"/>
                    <header>
                        <button name="action_reset_to_ready" string="Reset to Ready" type="object" class="oe_highlight" invisible="state not in ['cancel','reserved']"/>
                        <button name="action_reserved" string="Reserve" type="object" class="oe_highlight" invisible="state not in ['ready']"/>
                        <button name="action_sold" string="Sale" type="object" class="oe_highlight" invisible="1"/>
                        <button name="action_cancel" string="Cancel" type="object" class="oe_secondary" invisible="state=='cancel'"/>
                        <field name="state" widget="statusbar" invisible="state == 'cancel'"/>
                    </header>
                    <group>
                        <group string="Property Info">
                            <field name="project_id" readonly="state == 'sold'"/>
                            <field name="is_apartment" invisible="1"/>
                            <field name="is_villa" invisible="1"/>
                            <field name="name" readonly="state == 'sold'"/>
                            <field name="number_of_rooms" readonly="state == 'sold'" invisible="is_villa"/>
                            <field name="area" readonly="state == 'sold'" invisible="is_apartment"/>
                            <field name="private_space" readonly="state == 'sold'" invisible="is_apartment"/>
                            <field name="built_up_special_area" invisible="is_apartment"/>
                            <field name="total_area" invisible="is_villa"/>
                            <field name="bathroom" readonly="state == 'sold'"/>
                            <field name="maid_room" readonly="state == 'sold'" invisible="is_apartment"/>
                            <field name="maid_bathroom" readonly="state == 'sold'" invisible="is_apartment"/>
                            <field name="driver_room" readonly="state == 'sold'" invisible="is_apartment"/>
                            <field name="driver_bathroom" readonly="state == 'sold'" invisible="is_apartment"/>
                            <field name="nanny" readonly="state == 'sold'" invisible="is_villa"/>
                        </group>
                        <group string="Customer Info">
                            <field name="reserved_to_id" readonly="state == 'sold'"/>
                            <field name="sold_to_id" />
                            <field name="sale_order_id" />
                            <field name="product_template_id" />
                            <field name="unit_description" readonly="state == 'sold'" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Similar properties">
                            <field name="similar_project_ids" readonly="state == 'sold'">
                                <list>
                                    <field name="project_id"/>
                                    <field name="name"/>
                                    <field name="unit_description"/>
                                    <field name="number_of_rooms"/>
                                    <field name="total_area"/>
                                    <field name="reserved_to_id"/>
                                    <field name="sold_to_id"/>
                                    <field name="product_template_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="crm_projects_action" model="ir.actions.act_window">
        <field name="name">Crm Projects</field>
        <field name="res_model">crm.projects</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create Crm Projects
            </p>
        </field>
    </record>

    <record id="project_name_list" model="ir.ui.view">
        <field name="name">Project name list</field>
        <field name="model">project.name</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="is_apartment"/>
                <field name="is_villa"/>
            </list>
        </field>
    </record>

    <record id="project_name_view_form" model="ir.ui.view">
        <field name="name">Project Name View Form</field>
        <field name="model">project.name</field>
        <field name="arch" type="xml">
            <form string="project_name_form">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="is_apartment"/>
                            <field name="is_villa"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="project_name_action" model="ir.actions.act_window">
        <field name="name"> Projects Name </field>
        <field name="res_model">project.name</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create Projects names
            </p>
        </field>
    </record>

    <menuitem id="crm_projects_root_menu" name="Projects" parent="crm.crm_menu_config">
        <menuitem
            id="crm_projects_menu"
            name="Projects"
            action="crm_projects_action"/>

        <menuitem
            id="project_name_menu"
            name="Project Name"
            action="project_name_action"/>
    </menuitem>


</odoo>