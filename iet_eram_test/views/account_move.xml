<odoo>
    <data>
        <record id="view_move_form_inherit" model="ir.ui.view">
            <field name="name">account.move.form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form" />
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//field[@name='ref']" position="after">
                        <field name="journal_id_name" invisible="1" />
                    </xpath>

                    <xpath expr="//form/header/field[@name='state']" position="replace">
                        <field name="state"
                            widget="statusbar"
                            statusbar_visible="draft,technical_review,revision,posted"
                            invisible="journal_id_name in ['Miscellaneous Operations']"
                        />
                        <field name="state"
                            widget="statusbar"
                            statusbar_visible="draft,posted"
                            invisible="journal_id_name not in ['Miscellaneous Operations']"
                        />
                    </xpath>

                    <xpath expr="//button[@name='action_technical_review']" position="attributes">
                        <attribute name="invisible">journal_id_name in ['Miscellaneous Operations']</attribute>
                    </xpath>

                    <xpath expr="//form/header/button[@name='action_post']" position="attributes">
                        <attribute name="invisible">journal_id_name not in ['Miscellaneous Operations']</attribute>
                    </xpath>
                </data>
            </field>
        </record>
    </data>
</odoo>