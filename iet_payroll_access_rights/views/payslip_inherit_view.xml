<odoo>
    <data>

        <record id="inherit_view_hr_payslip_form" model="ir.ui.view">
            <field name="name">hr payslip form inherit</field>
            <field name="model">hr.payslip</field>
            <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <xpath expr="//header[1]" position="inside">
                   <field name="can_confirmed" invisible="1"/>
                   <field name="can_approved" invisible="1"/>
                   <field name="can_paid" invisible="1"/>
                </xpath>
                <xpath expr="//button[@name='compute_sheet'][1]" position="attributes">
                    <attribute name="invisible">state not in 'draft' or credit_note == True or can_confirmed == False</attribute>
                </xpath>
                <xpath expr="//button[@name='action_payslip_done'][1]" position="attributes">
                    <attribute name="invisible">state not in 'verify' or can_approved == False</attribute>
                </xpath>
                <xpath expr="//button[@name='action_payslip_paid']" position="replace">
                    <button string="Mark as paid" name="action_payslip_paid" type="object" class="oe_highlight"
                            invisible="state not in 'done' or can_paid == False"/>
                </xpath>

            </field>
        </record>

    </data>
</odoo>