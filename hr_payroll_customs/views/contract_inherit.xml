<odoo>
    <data>
        <record id="hr_contract_form_inherit00" model="ir.ui.view">
            <field name="name">hr.contract.form.inherit</field>
            <field name="model">hr.contract</field>
            <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='date_start']" position="before">
                    <field name="month_count"/>
                </xpath>
                <xpath expr="//page[@name='information']//group[@name='salary']" position="inside">
                    <label for="custom_transportation_allowance"/>
                    <div class="o_row" id="custom_transportation_allowance">
                        <field name="custom_transportation_allowance" nolabel="1"/>
                        <span>
                            <field name="base_currency_id" invisible="1"
                                   options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                            / month
                        </span>
                    </div>
                    <label for="food_allowance"/>
                    <div class="o_row" id="food_allowance">
                        <field name="food_allowance" nolabel="1"/>
                        <span>
                            <field name="base_currency_id" invisible="1"
                                   options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                            / month
                        </span>
                    </div>
                    <label for="phone_allowance"/>
                    <div class="o_row" id="phone_allowance">
                        <field name="phone_allowance" nolabel="1"/>
                        <span>
                            <field name="base_currency_id" invisible="1"
                                   options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                            / month
                        </span>
                    </div>

                    <label for="total_salary"/>
                    <div class="o_row">
                        <field name="total_salary" nolabel="1"/>
                        <span>
                            <field name="base_currency_id" invisible="1"
                                   options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                            / month
                        </span>
                        <button string="Compute" name="compute_total_salary" type="object" class="btn-primary"/>
                    </div>


                </xpath>
                <xpath expr="//page[@name='information']" position="after">
                    <page string="History" name="history">
                        <field name="contract_history_line_ids" nolabel="1" readonly="0">
                            <tree editable="bottom">
                                <field name="date_start"/>
                                <field name="total_salary"/>
                            </tree>
                        </field>
                    </page>
                </xpath>

                <xpath expr="//label[@for='l10n_sa_transportation_allowance']" position="replace">
                    <label for="l10n_sa_transportation_allowance"
                           invisible="company_id.l10n_sa_company_country_code != 'SA'"
                           string="Bonus"/>
                </xpath>

            </field>
        </record>

        <record id="hr_payslip_form_inherit00" model="ir.ui.view">
            <field name="name">hr.payslip.form.inherit</field>
            <field name="model">hr.payslip</field>
            <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='employee_id']" position="after">
                    <field name="accrual_leave" invisible="1"/>
                </xpath>
                <xpath expr="//field[@name='struct_id']" position="after">
                    <field name="show_last_payslip"/>
                </xpath>

                <xpath expr="//page[@name='worked_days_input']" position="replace">
                    <page string="Worked Days &amp; Inputs" name="worked_days_input">
                        <separator string="Worked Days" invisible="1"/>
                        <field name="worked_days_line_ids" invisible="1">
                            <tree string="Worked Days" editable="bottom" create="0" delete="0">
                                <field name="name"/>
                                <field name="currency_id" invisible="1"/>
                            </tree>
                            <form string="Worked Day">
                                <group col="4">
                                    <field name="name"/>
                                    <field name="contract_id"/>
                                    <field name="currency_id" invisible="1"/>
                                </group>
                            </form>
                        </field>
                        <group>
                            <group>
                                <field name="number_of_absences_days"/>
                                <field name="amount_of_absences"/>
                                <field name="customs_attendances"/>
                                <field name="amount_of_attendances"/>
                            </group>
                            <group>
                                <field name="number_of_penalties_days"/>
                                <field name="amount_of_penalties"/>
                                <field name="overtime"/>
                                <field name="termination_amount"/>
                            </group>
                        </group>
                        <separator string="Other Inputs"/>
                        <div class="alert alert-warning" role="alert">
                             invisible="negative_net_to_report_display == False"
                            <field name="negative_net_to_report_message"/>
                            <button name="action_report_negative_amount" class="oe_link" type="object"
                                    string=" -&gt; Report"/>
                        </div>
                        <field name="input_line_ids" colspan="4" nolabel="1">
                            <tree string="Input Data" editable="bottom">
                                <!--
                                    Required 0 to force client to send on change request even when not defined
                                    Salary Attachments would otherwise not properly be computed and payslip_id is
                                    required for _allowed_input_type_ids to work..
                                -->
                                <field name="_allowed_input_type_ids" invisible="1"/>
                                <field name="input_type_id"/>
                                <field name="name"/>
                                <field name="contract_id" invisible="True"/>
                            </tree>
                            <form string="Payslip Line">
                                <group col="4">
                                    <field name="_allowed_input_type_ids" invisible="1"/>
                                    <field name="input_type_id"/>
                                    <field name="name"/>
                                    <field name="contract_id"/>
                                </group>
                            </form>
                        </field>
                    </page>
                </xpath>

            </field>
        </record>

        <record id="hr_employee_form_inherit02" model="ir.ui.view">
            <field name="name">hr.employee.form.inherit</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="compute_custom_accrual_leave" string='Compute Accrual' type="object"
                            class="oe_stat_button"/>
                </xpath>

                <xpath expr="//notebook" position="inside">
                    <!--          <page name="emp_history" string="Payroll Information">-->
                    <page name="emp_history" string="Accrual Leave Information">
                        <group>
                            <group>

                                <field name="custom_duration0_due0"/>
                                <field name="custom_duration0_due_less_than5" force_save="1"/>
                                <field name="custom_total0_year0"/>

                                <label for="total_days_all"/>
                                <div class="o_row" name="div_total_days_all">
                                    <field name="total_days_all" groups="hr.group_hr_user"/>
                                    <span>
                                        <field name="amount_of_total_days"/>
                                    </span>
                                </div>
                                <!--                <field name="total_days_all"/>-->
                                <!--                <field name="amount_of_total_days"/>-->

                                <label for="time_off_custom_days"/>
                                <div class="o_row" name="div_time_off_custom_days">
                                    <field name="time_off_custom_days" groups="hr.group_hr_user"/>
                                    <span>
                                        <field name="custom_accrual0_leave0"/>
                                    </span>
                                </div>
                            </group>
                            <group>
                                <field name="last_time_off_last_days"/>

                                <label for="in_a_num_to_compute"/>
                                <div class="o_row" name="div_in_a_num_to_compute">
                                    <field name="in_a_num_to_compute" groups="hr.group_hr_user"/>
                                    <span>
                                        <field name="amount_of_days_taken"/>
                                    </span>
                                </div>

                                <div class="o_td_label">
                                    <label for="net_days" string="Net Days"/>
                                </div>
                                <div name="net_days">
                                    <field name="net_days"/>
                                    <span class="ml16"/>
                                    <field name="amount_of_net_days"/>
                                </div>
                                <!--                <field name="net_days"/>-->
                                <!--                <field name="amount_of_net_days"/>-->
                                <field name="thirty_days"/>
                            </group>
                            <!--              <group>-->
                            <group string="Fields To Explain Compute Accrual"
                                   groups="hr_payroll_customs.group_get_fields">
                                <field name="date11_return_vacation11"/>
                                <field name="date22_return_vacation22"/>
                                <field name="more11_than_vacation11"/>
                                <field name="more22_than_vacation22"/>
                                <field name="custom_today_date00"/>
                                <field name="custom_first_contract_date00_custom"/>
                                <field name="no_vacation11"/>
                                <field name="no_custom_vacation22"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

    </data>
</odoo>