<odoo>
    <data>
        <record id="hr_leave_form_inherit02" model="ir.ui.view">
            <field name="name">hr.leave.form.inherit</field>
            <field name="model">hr.leave</field>
            <field name="inherit_id" ref="hr_holidays.hr_leave_view_form_manager"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="date_now"/>
                    <field name="time_off_types" required="1"/>
                    <field name="return_date" required="1"/>
                    <field name="last_working_date" required="1"/>
                    <field name="return_vacation_ids" widget="many2many_tags" invisible="1"/>
                    <field name="amount"/>
                </xpath>
                <xpath expr="//sheet//div" position="before">
                    <div class="oe_button_box" name="button_box">
                        <button name="open_return_vacation" type="object" class="oe_stat_button" icon="fa-bars"
                                invisible="return_vacation_count == 0">
                            <field name="return_vacation_count" string="Return From Vacation" widget="statinfo"/>
                        </button>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>