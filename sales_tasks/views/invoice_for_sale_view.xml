<odoo>
  <data>

    <record id="inherit_custom_move_form_view" model="ir.ui.view">
      <field name="name">view.move.form.inherit</field>
      <field name="model">account.move</field>
      <field name="inherit_id" ref="account.view_move_form"/>
      <field name="arch" type="xml">

        <xpath expr="//field[@name='invoice_line_ids']" position="after">
          <field name="acc_vendor_line" widget="section_and_note_one2many"
                 mode="list,kanban"
                 context="{'default_state': 'draft'}"
                 readonly="state in ('posted', 'cancel')">
            <list string="Vendor Order Lines" editable="bottom">
              <field name="sproduct_id"/>
              <field name="svendor_name"/>
              <field name="sprice"/>
            </list>
          </field>
        </xpath>

        <xpath expr="//field[@name='invoice_line_ids']/list//field[@name='account_id']" position="after">
          <field name="fees_or_receipts" optional="show"/>
        </xpath>
        <xpath expr="//field[@name='invoice_line_ids']/list//field[@name='price_unit']" position="after">
          <field name="the_beneficiary" optional="show"/>
        </xpath>

        <xpath expr="//field[@name='line_ids']/list/field[@name='name']" position="after">
          <field name="fees_or_receipts" invisible="1"/>
          <field name="the_beneficiary" invisible="1"/>
        </xpath>

      </field>
    </record>

     <record id="sales_tasks_view_invoice_tree_inherit" model="ir.ui.view">
      <field name="name">view.out.invoice.tree</field>
      <field name="model">account.move</field>
      <field name="inherit_id" ref="account.view_out_invoice_tree"/>
      <field name="arch" type="xml">
        <field name="amount_untaxed_in_currency_signed" position="after">
          <field name="custom_amount_total" optional="show"/>
        </field>
      </field>
    </record>
     <record id="sales_tasks_view_bill_tree_inherit" model="ir.ui.view">
      <field name="name">view.out.bill.tree</field>
      <field name="model">account.move</field>
      <field name="inherit_id" ref="account.view_in_invoice_bill_tree"/>
      <field name="arch" type="xml">
        <field name="amount_untaxed_in_currency_signed" position="after">
          <field name="custom_amount_total" optional="show"/>
        </field>
      </field>
    </record>

  </data>
</odoo>
