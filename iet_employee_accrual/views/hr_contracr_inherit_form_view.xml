<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <!-- First view: Extend the standard HR Contract Form -->
    <record id="hr_contract_form_inherit0011" model="ir.ui.view">
      <field name="name">hr.contract.form.inherit</field>
      <field name="model">hr.contract</field>
      <!-- Inherit from the standard HR contract form view -->
      <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='date_start']" position="before">
          <field name="month_counts"/>
        </xpath>
      </field>
    </record>

    <!-- Second view: Further modifications -->
    <record id="hr_contract_form_inherit00113" model="ir.ui.view">
      <field name="name">hr.contract.form.inherit.extra</field>
      <field name="model">hr.contract</field>
      <field name="inherit_id" ref="iet_employee_accrual.hr_contract_form_inherit0011"/>
      <field name="arch" type="xml">
        <!-- Hide the inserted month_counts field (if present) -->
        <xpath expr="//field[@name='month_counts']" position="attributes" optional="1">
          <attribute name="invisible">1</attribute>
        </xpath>
        <xpath expr="//page[@name='information']//group[@name='salary']//div[@name='l10n_sa_housing_allowance']" position="after" optional="1">
          <label for="custom_transportation_allowance"/>
          <div class="o_row" id="custom_transportation_allowance">
            <field name="custom_transportation_allowance" nolabel="1"/>
            <span>
              <field name="base_currency_id" invisible="1"
                     options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
              / month
            </span>
          </div>
          <label for="food_allowance"/>
          <div class="o_row" id="food_allowance">
            <field name="food_allowance" nolabel="1"/>
            <span>
              <field name="base_currency_id" invisible="1"
                     options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
              / month
            </span>
          </div>
          <label for="phone_allowance"/>
          <div class="o_row" id="phone_allowance">
            <field name="phone_allowance" nolabel="1"/>
            <span>
              <field name="base_currency_id" invisible="1"
                     options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
              / month
            </span>
          </div>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
