<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <!--purchase view-->
    <record id="purchase_order_form_inherit" model="ir.ui.view">
      <field name="name">view.purchase.order.form</field>
      <field name="model">purchase.order</field>
      <field name="inherit_id" ref="purchase.purchase_order_form"/>
      <field name="arch" type="xml">

        <xpath expr="//form/header/field[@name='state']" position="replace">
          <field name="state"
                 widget="statusbar"
                 statusbar_visible="draft,technical_review,revision,sent,purchase"
                 readonly="1"
          />
        </xpath>

        <xpath expr="//button[@id='draft_confirm']" position="replace">
          <button name="button_confirm" type="object"
                  groups="iet_customs.set_to_confirm"
                  context="{'validate_analytic': True}"
                  confirm="Are you sure you want to proceed ?"
                  string="Confirm Order" id="draft_confirm"
                  invisible="state not in ('draft', 'revision')"
          />
        </xpath>
        <xpath expr="//button[@id='bid_confirm']" position="replace">



          <button name="button_confirm"
                  groups="iet_customs.set_to_confirm"
                  type="object"
                  class="oe_highlight"
                  confirm="Are you sure you want to proceed ?"
                  data-hotkey="v"
                  invisible="state not in ('sent', 'revision')"
                  context="{'validate_analytic': True}"
                  string="Confirm Order"
                  id="draft_confirm"/>
        </xpath>
        <xpath expr="//button[@name='button_draft']" position="replace">
          <button name="button_draft" invisible="state not in ('cancel', 'revision', 'technical_review')" string="Set to Draft" type="object"
                  data-hotkey="o"/>
        </xpath>


        <xpath expr="//header//button[@name='button_cancel']" position="before">

          <button
                  name="action_technical_review"
                  string="Technical Review"
                  type="object"
                  class="oe_highlight"
                  groups="iet_customs.set_to_technical_review"
                  invisible="state not in ('draft')"
          />
          <button
                  name="action_revision"
                  string="To Revision"
                  type="object"
                  class="oe_highlight"
                  groups="iet_customs.set_to_revision"
                  invisible="state not in ('technical_review')"
          />

        </xpath>
      </field>
    </record>


    <!--sale view-->
    <record model="ir.ui.view" id="sale_order_form_view_inherited">
      <field name="name">sale.order.form.view.inherited</field>
      <field name="model">sale.order</field>
      <field name="inherit_id" ref="sale.view_order_form"/>
      <field name="arch" type="xml">

        <xpath expr="//form/header/field[@name='state']" position="replace">
          <field name="state" widget="statusbar" statusbar_visible="draft,sent,technical_review,revision,sale"/>
        </xpath>

        <xpath expr="//button[@id='action_confirm']" position="replace">
          <button name="action_confirm"
                  id="action_confirm"
                  confirm="Are you sure you want to proceed ?"
                  data-hotkey="v"
                  groups="iet_customs.set_to_confirm_sales"
                  string="Confirm" class="btn-primary" type="object"
                  context="{'validate_analytic': True}"
                  invisible="state not in ('sent', 'revision')"
          />
        </xpath>

        <xpath expr="//button[@name='action_confirm'][2]" position="replace">
          <button name="action_confirm"
                  data-hotkey="v"
                  groups="iet_customs.set_to_confirm_sales"
                  confirm="Are you sure you want to proceed ?"
                  string="Confirm"
                  type="object"
                  context="{'validate_analytic': True}"
                  invisible="1"
          />
        </xpath>

        <xpath expr="//header//button[@name='action_cancel']" position="before">

          <button
                  name="action_technical_review"
                  string="Technical Review"
                  type="object"
                  class="oe_highlight"
                  groups="iet_customs.set_to_technical_review_sales"
                  invisible="state not in ('draft')"
          />
          <button
                  name="action_revision"
                  string="To Revision"
                  type="object"
                  class="oe_highlight"
                  groups="iet_customs.set_to_revision_sales"
                  invisible="state not in ('technical_review')"
          />

        </xpath>


      </field>
    </record>


    <!--payment view-->

    <record id="account_payment_form_inherit" model="ir.ui.view">
      <field name="name">account.payment.form.inherited</field>
      <field name="model">account.payment</field>
      <field name="inherit_id" ref="account.view_account_payment_form"/>
      <field name="arch" type="xml">

        <xpath expr="//form/header/field[@name='state']" position="replace">
          <field name="state"
                 widget="statusbar"
                 statusbar_visible="draft,technical_review,revision,posted"
          />
        </xpath>

        <xpath expr="//button[@name='action_post']" position="attributes">
          <attribute name="groups">iet_customs.set_to_confirm_payment</attribute>
          <attribute name="invisible">state not in 'revision'</attribute>
        </xpath>


        <xpath expr="//button[@name='action_cancel']" position="before">
          <button
                  name="action_technical_review"
                  string="Technical Review"
                  type="object"
                  class="oe_highlight"
                  groups="iet_customs.set_to_technical_review_payment"
                  invisible="state not in ('draft')"
          />
          <button
                  name="action_revision"
                  string="To Revision"
                  type="object"
                  class="oe_highlight"
                  groups="iet_customs.set_to_revision_payment"
                  invisible="state not in ('technical_review')"
          />

        </xpath>

      </field>
    </record>

    <!--invoice bill view-->

    <record id="form_inherit_account_move_form_custom" model="ir.ui.view">
      <field name="name">account.move</field>
      <field name="model">account.move</field>
      <field name="inherit_id" ref="account.view_move_form"/>
      <field name="arch" type="xml">

        <xpath expr="//form/header/field[@name='state']" position="replace">
          <field name="state"
                 widget="statusbar"
                 statusbar_visible="draft,technical_review,revision,posted"
          />
        </xpath>

        <xpath expr="//button[@name='action_post']" position="attributes">
          <attribute name="groups">iet_customs.set_to_confirm_invoice_bill</attribute>
          <attribute name="invisible">state not in ('revision')</attribute>
        </xpath>

        <xpath expr="//button[@name='action_post'][2]" position="attributes">
          <attribute name="invisible">1</attribute>
          <attribute name="invisible">state not in ('revision')</attribute>
        </xpath>


        <xpath expr="//button[@name='button_cancel']" position="before">
          <button
                  name="action_technical_review"
                  string="Technical Review"
                  type="object"
                  class="oe_highlight"
                  groups="iet_customs.set_to_technical_review_invoice_bill"
                  invisible="state not in ('draft')"
          />
          <button
                  name="action_revision"
                  string="To Revision"
                  type="object"
                  class="oe_highlight"
                  groups="iet_customs.set_to_revision_invoice_bill"
                  invisible="state not in ('technical_review')"
          />
        </xpath>

      </field>
    </record>


  </data>
</odoo>