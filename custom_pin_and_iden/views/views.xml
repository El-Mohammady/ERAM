<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hr_view_employee_form_inherit_custom_pin_and_iden" model="ir.ui.view">
            <field name="name">hr view employee form</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//h1" position="after">
                    <h2>
                        <field name="custom_employee_pin_number" readonly="1" force_save="1"/>
                    </h2>
                </xpath>
            </field>
        </record>

    </data>
</odoo>